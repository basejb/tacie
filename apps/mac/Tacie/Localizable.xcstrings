    },
    "GitHub를 연결하면 코드와 이슈·PR에서도 찾아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect GitHub to search code, issues and pull requests too."
          }
        }
      }
    },
    "Google Drive를 연결하면 문서, 시트, 슬라이드에서도 찾아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect Google Drive to search files in Docs, Sheets and Slides too."
