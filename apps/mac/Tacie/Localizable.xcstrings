        }
      }
    },
    "Jira · Confluence를 연결하면 이슈와 팀 문서에서도 찾아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect Jira and Confluence to search issues and team docs too."
