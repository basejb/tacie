    },
    "Tacie 서버를 거쳐 가는 정보는 전달만 하고 저장하지 않아요." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whatever passes through Tacie's server is only forwarded, never stored."
